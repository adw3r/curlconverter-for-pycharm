{
  "name": "curlconverter-intellij-bundle",
  "version": "1.1.0",
  "private": true,
  "description": "Bundles curlconverter (+ the curl_cffi generator) for the curlconverter PyCharm/IntelliJ plugin",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test:diff": "node test/diff.mjs python,python-http,go,node,php",
    "test:browser": "node test/browser.mjs",
    "test:e2e": "python3 test/curl_cffi_e2e.py",
    "expected": "node test/gen-expected.mjs ../plugin/src/test/resources/expected.json"
  },
  "dependencies": {
    "curlconverter": "4.12.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
